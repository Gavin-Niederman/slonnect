diff -ru a/plugins/presenter/CMakeLists.txt b/plugins/presenter/CMakeLists.txt
--- a/plugins/presenter/CMakeLists.txt	2026-11-18 15:21:32.314052950 -0800
+++ b/plugins/presenter/CMakeLists.txt	2026-11-18 15:21:48.605104303 -0800
@@ -10,3 +10,11 @@
 )
 
 install(FILES "kdeconnect_presenter_config.qml" DESTINATION ${KDE_INSTALL_DATADIR}/kdeconnect)
+
+# On Wayland, show the pointer as a transparent overlay layer surface instead of a
+# fullscreen toplevel (which compositors like niri paint over a black backdrop).
+find_package(LayerShellQt QUIET)
+if(LayerShellQt_FOUND)
+    target_link_libraries(kdeconnect_presenter LayerShellQt::Interface)
+    target_compile_definitions(kdeconnect_presenter PRIVATE HAVE_LAYER_SHELL=1)
+endif()
