     PresenterView(const QString &filename)
         : m_current(filename)
     {
-        Qt::WindowFlags windowFlags = Qt::WindowFlags(Qt::WindowDoesNotAcceptFocus | Qt::WindowFullScreen | Qt::WindowStaysOnTopHint | Qt::FramelessWindowHint
-                                                      | Qt::Tool | (int)(Qt::WA_TranslucentBackground));
+        // Transparency needs an alpha channel in the surface, not just a clear colour.
+        QSurfaceFormat surfaceFormat = format();
+        surfaceFormat.setAlphaBufferSize(8);
+        setFormat(surfaceFormat);
+        setColor(QColor(Qt::transparent));
+
+        Qt::WindowFlags windowFlags =
+            Qt::WindowFlags(Qt::WindowDoesNotAcceptFocus | Qt::WindowFullScreen | Qt::WindowStaysOnTopHint | Qt::FramelessWindowHint | Qt::Tool);
 #ifdef Q_OS_WIN
         windowFlags |= Qt::WindowTransparentForInput;
 #endif
+
+#ifdef HAVE_LAYER_SHELL
+        if (QGuiApplication::platformName().startsWith(QLatin1String("wayland"))) {
+            if (auto *layer = LayerShellQt::Window::get(this)) {
+                // Above everything (fullscreen apps included), over the whole output,
+                // never taking keyboard focus or space from panels.
+                layer->setLayer(LayerShellQt::Window::LayerOverlay);
+                layer->setAnchors(LayerShellQt::Window::Anchors(LayerShellQt::Window::AnchorTop | LayerShellQt::Window::AnchorBottom
+                                                                | LayerShellQt::Window::AnchorLeft | LayerShellQt::Window::AnchorRight));
+                layer->setExclusiveZone(-1);
+                layer->setKeyboardInteractivity(LayerShellQt::Window::KeyboardInteractivityNone);
+                layer->setScope(QStringLiteral("kdeconnect-presenter"));
+                // Clicks go through to the slides underneath.
+                windowFlags |= Qt::WindowTransparentForInput;
+                m_layerShell = true;
+            }
+        }
+#endif
         setFlags(windowFlags);
-        setColor(QColor(Qt::transparent));
 
-        setResizeMode(QQuickView::SizeViewToRootObject);
+        // The compositor sizes a layer surface from its anchors; the scene follows.
+        setResizeMode(m_layerShell ? QQuickView::SizeRootObjectToView : QQuickView::SizeViewToRootObject);
         setSource(QUrl(QStringLiteral("qrc:/presenter/%1").arg(filename)));
 
         const auto ourErrors = errors();
